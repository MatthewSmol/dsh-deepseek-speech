{
  "name": "@local/dsh-deepseek-speech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek ASR, Edge/DeepSeek TTS, and an MCP service for Telegram voice messages with sidebar usage statistics.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts/*.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "msedge-tts": "^2.1.1",
    "zod": "^4.6.7"
  }
}
