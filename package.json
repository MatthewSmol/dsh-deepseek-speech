{
  "name": "@local/dsh-deepseek-speech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek ASR, Edge/DeepSeek TTS, and an MCP service with a Vue 3 sidebar (scoped CSS) for Telegram voice messages.",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/**/*.js",
    "src/**/*.ts",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.client.json",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts/*.sh",
    "scripts/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "msedge-tts": "^2.1.1",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit && npm run build-client && node scripts/sync-compat.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "build-client": "vite build --config vite.config.ts"
  }
}
